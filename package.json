{
  "name": "@qrotux/editrig-shadcn-react",
  "version": "0.1.0",
  "description": "Server-driven entity editor for React on shadcn/ui and rjsf: schema-driven forms, relation pickers, media uploads, keyed and repeatable blocks.",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qrotux/editrig-shadcn-react.git"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react-router": {
      "types": "./dist/react-router.d.ts",
      "import": "./dist/react-router.js"
    },
    "./theme.css": "./dist/theme.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "prepare": "tsup",
    "typecheck": "tsc --noEmit && tsc --noEmit -p examples",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@rjsf/core": "^6.10",
    "@rjsf/shadcn": "^6.10",
    "@rjsf/utils": "^6.10",
    "@rjsf/validator-ajv8": "^6.10",
    "@tanstack/react-query": "^5",
    "lucide-react": ">=0.400.0",
    "react": "^19",
    "react-dom": "^19",
    "react-router-dom": "^7"
  },
  "peerDependenciesMeta": {
    "react-router-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1",
    "@radix-ui/react-dropdown-menu": "^2",
    "@radix-ui/react-popover": "^1",
    "@radix-ui/react-slot": "^1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2",
    "cmdk": "^1",
    "tailwind-merge": "^3",
    "vanilla-jsoneditor": "^3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rjsf/core": "^6.10.0",
    "@rjsf/shadcn": "^6.10.0",
    "@rjsf/utils": "^6.10.0",
    "@rjsf/validator-ajv8": "^6.10.0",
    "@tanstack/react-query": "^5.101.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "lucide-react": "^0.550.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.10"
  }
}
