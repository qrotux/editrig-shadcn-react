{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    // Examples import the package the way a consumer does; these paths resolve
    // those specifiers to the live sources, so a breaking API change fails
    // typecheck here instead of silently rotting the examples.
    "baseUrl": "..",
    "paths": {
      "@qrotux/editrig-shadcn-react": ["src/index.ts"],
      "@qrotux/editrig-shadcn-react/react-router": ["src/react-router.ts"]
    }
  },
  "include": ["."]
}
